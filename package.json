{
  "name": "authula",
  "type": "module",
  "version": "0.7.13",
  "description": "Official SDK for Authula.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Authula/authula-node-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Authula/authula-node-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Authula/authula-node-sdk/issues"
  },
  "exports": {
    ".": "./dist/index.js",
    "./plugins": "./dist/plugins/index.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "pnpm run orval:build && pnpm run tsdown:build",
    "orval:build": "rm -rf ./src/gen && orval -c orval.config.ts",
    "tsdown:build": "rm -rf ./dist && tsdown",
    "watch:orval": "orval",
    "watch:tsdown": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "prepublishOnly": "pnpm run orval:build && pnpm run tsdown:build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "cookie": "^2.0.1",
    "es-toolkit": "^1.52.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "bumpp": "^12.2.2",
    "orval": "^8.23.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
